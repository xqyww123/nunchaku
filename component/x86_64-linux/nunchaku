#!/usr/bin/env bash
# Resolves its own dir on purpose -- do NOT read $NUNCHAKU_HOME here
# (the bundled cvc5 wrapper reads $CVC5_HOME and breaks when unset).
NUN_DIR="$(cd "$(dirname "$0")" && pwd)"
export NUNCHAKU_CVC5="$NUN_DIR/solvers/cvc5"
# --no-spurious-models is the binary's own default since 0.5.3, and the flag
# is kept as an accepted no-op; passing it here keeps the component from
# depending on that default.  Why the default is what it is: the stock
# Isabelle frontend classifies on the first output token and never sees the
# "(potentially spurious)" marker, so without suppression it would present
# spurious countermodels as genuine (witnessed on "(a::int) * a >= a" via
# the incomplete quotient encoding of int).
exec "$NUN_DIR/nunchaku-bin" --no-spurious-models "$@"

; Hermetic guard suite for the strict cvc5 domain-reply parser.
;
; Every case replays a canned cvc5 reply through the fake solver, so the suite
; pins what nunchaku does with a malformed reply -- something no run against a
; real, correct cvc5 can exercise.  Cases 2-8 must all end in UNKNOWN +
; BACKEND_ERROR + rc=0: that is the No_shortcut contract, i.e. one unusable
; reply costs its own arm and leaves the siblings running.
;
; Cases 9-10 pin the empty-NUNCHAKU_CVC5 error and its blast radius.  Both go
; through run_case because a dune rule cannot declare a non-zero expected exit
; before (lang dune 2.2).

(rule
 (targets ok.out)
 (deps
  %{exe:../support/run_case.exe}
  %{exe:../support/fake_solver.exe}
  %{exe:../../src/main/nunchaku.exe}
  three.nun
  reply_ok.txt)
 (action
  (with-stdout-to
   ok.out
   (run
    %{exe:../support/run_case.exe}
    --exe
    %{exe:../../src/main/nunchaku.exe}
    --deadline
    20
    --setenv
    "NUNCHAKU_CVC5=%{exe:../support/fake_solver.exe}"
    --setenv
    "FAKE_REPLIES=%{dep:reply_ok.txt}"
    --
    --solvers
    cvc5
    --no-color
    -j
    1
    --timeout
    5
    %{dep:three.nun}))))

(rule
 (alias runtest)
 (action
  (diff ok.expected ok.out)))


; Hermetic guard suite for the cvc5 backend's reply decoding.
;
; Every case replays a canned cvc5 reply through the fake solver, so the suite
; pins what nunchaku does with a reply it cannot use -- something no run
; against a real, correct cvc5 can exercise.  The negative cases must all end
; in UNKNOWN + BACKEND_ERROR + rc=0: that is the No_shortcut contract, i.e. one
; unusable reply costs its own arm and leaves the siblings running.
;
; The rules are generated: they are all the same shape, so the case table lives
; in gen_dune.ml and dune.inc is promoted from it.
(include dune.inc)

(rule
 (targets dune.inc.gen)
 (deps
  (:gen gen_dune.ml))
 (action
  (with-stdout-to
   %{targets}
   (run ocaml %{gen}))))

(rule
 (alias runtest)
 (action
  (diff dune.inc dune.inc.gen)))
